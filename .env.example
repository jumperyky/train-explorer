# ------------------------------------------------------------------
# .env.local（ローカル）/ Vercel の Environment Variables にコピーして使う。
# 実際のキーは絶対にコミットしないこと。
# ------------------------------------------------------------------

# 公共交通オープンデータセンター(ODPT) のアクセストークン
# https://developer.odpt.org/ で取得。未設定でもアプリはモックデータで動く。
ODPT_ACCESS_TOKEN=

# バックエンドを Vercel 以外（Render 等）に置く場合だけ設定する。
# 例: https://train-explorer-api.onrender.com
API_ORIGIN=

# フロントから直接別オリジンのAPIを叩きたい場合のみ（通常は未設定でよい）。
NEXT_PUBLIC_API_BASE_URL=

# 画像・ODPTレスポンスのキャッシュ秒数（バックエンド）
CACHE_TTL_SECONDS=3600

# Wikimedia は連絡先の無い User-Agent を 403 で弾く。
# 既定値としてこのリポジトリのURLを埋めてあるので、通常は設定不要。
# フォークした場合など、連絡先を変えたいときだけ設定する。
# https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
WIKI_USER_AGENT=

# 取得する写真の横幅(px)。MediaWiki が許可済みサイズに切り上げる。
IMAGE_WIDTH=
